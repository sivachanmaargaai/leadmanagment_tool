# Copy this file to backend/.env.local for local development.
# The legacy .env is not loaded; Render uses dashboard environment variables.
DATABASE_URL=postgresql+psycopg://crm_user:CHANGE_ME@localhost:5432/engen_crm
ENVIRONMENT=development
ALLOW_REMOTE_DEVELOPMENT_DATABASE=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7

# Enable only after migrations, provider credentials and delivery checks. Never commit real credentials.
PASSWORD_RECOVERY_ENABLED=false
# gmail uses HTTPS and works without SMTP ports (including Render Free).
MAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=engenwebsite@gmail.com
OTP_MINUTES=10
# Legacy reset-link settings; SMTP mode still validates the trusted base URL.
RESET_LINK_MINUTES=15
RESET_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ENGEN CRM
SMTP_TIMEOUT_SECONDS=10

# Shared database-backed request budgets. Production requires this enabled.
RATE_LIMIT_ENABLED=true
API_IP_PER_MINUTE=600
API_IP_BURST_PER_10_SECONDS=100
API_USER_PER_MINUTE=300
API_USER_WRITES_PER_MINUTE=60
LOGIN_IP_PER_15_MINUTES=20
LOGIN_EMAIL_PER_15_MINUTES=10
# Byte limits: JSON 1 MiB, auth 16 KiB, multipart upload total 12 MiB.
# The existing individual PDF file cap remains 10 MiB.
REQUEST_JSON_MAX_BYTES=1048576
REQUEST_AUTH_MAX_BYTES=16384
REQUEST_UPLOAD_MAX_BYTES=12582912
REQUEST_HEADER_MAX_BYTES=16384
REQUEST_MAX_HEADERS=100
REQUEST_URL_MAX_BYTES=4096
REQUEST_BODY_TIMEOUT_SECONDS=30

# Local operations. No automatic schedule/offsite copy is installed.
# OPS_DIRECTORY defaults to backend/var; keep it private and outside public files.
PG_BIN_DIRECTORY=
BACKUP_RETENTION_COUNT=7
BACKUP_MAX_AGE_HOURS=30
BACKUP_TOOL_TIMEOUT_SECONDS=600
# Optional separate PostgreSQL role/cluster for creating temporary restore-test databases.
BACKUP_RESTORE_ADMIN_URL=
OPS_LOG_ENABLED=true
OPS_LOG_MAX_BYTES=5242880
OPS_LOG_BACKUP_COUNT=3
OPS_SLOW_REQUEST_SECONDS=2
OPS_RECENT_ERROR_THRESHOLD=5
OPS_MIN_FREE_BYTES=536870912
OPS_HEALTH_BASE_URL=http://127.0.0.1:8000
